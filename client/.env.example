VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_WEATHER_API_KEY=optional-weatherapi-key
VITE_MAPS_API_KEY=optional-browser-safe-maps-key
# Keep private AI keys like GEMINI_API_KEY out of client env. Set them as Supabase Edge Function secrets instead.
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
VITE_ENABLE_ADMIN_ANALYTICS=true
VITE_MONITORING_DSN=
